{
  "name": "lgg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "collector": "go -C collector-go run .",
    "test": "node --experimental-strip-types tests/run-tests.mjs",
    "validate": "node scripts/validate-site.mjs",
    "check": "pnpm validate && pnpm test && pnpm check:worker && pnpm build",
    "check:worker": "tsc -p cloudflare/tsconfig.json",
    "d1:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "d1:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "d1:migrate:local": "wrangler d1 migrations apply lgg --local --config cloudflare/wrangler.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply lgg --remote --config cloudflare/wrangler.jsonc"
  },
  "version": "1.0.0",
  "description": "支持游客本地缓存与 Cloudflare D1 共享数据的英雄联盟内部 PVP 天命编排工具。",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyicode/lgg.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hyicode/lgg/issues"
  },
  "homepage": "https://github.com/hyicode/lgg#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "pinyin-pro": "^3.28.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "^4.167.0"
  }
}
